{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Relevant-S/ba-tools/skills/portal-publish/contract/publish-reply-1.schema.json",
  "title": "publish-reply/1",
  "description": "The 200 reply to a Publish. kind says which form: dashboard (POST /api/v1/publish/dashboard) or page (POST /api/v1/publish/page). On a dry run (?dry_run=1) it also carries client_view (for a Dashboard, the view of its dashboard/1, dashboard/2 or timeline/1 send, and client_contact_names), and nothing is stored or logged. The top level only picks the form by kind; each form in $defs is a closed object.",
  "type": "object",
  "if": { "properties": { "kind": { "const": "page" } }, "required": ["kind"] },
  "then": { "$ref": "#/$defs/page" },
  "else": { "$ref": "#/$defs/dashboard" },
  "$defs": {
    "dashboard": {
      "description": "The Dashboard form: the 200 reply to POST /api/v1/publish/dashboard. On a dry run it also carries client_view and client_contact_names.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "publish_id", "received_at", "kind", "counts", "dry_run"],
      "properties": {
        "contract": { "type": "string", "const": "publish-reply/1" },
        "publish_id": {
          "description": "The id of the stored version (UUID v7). On a dry run nothing is stored, so it is null.",
          "anyOf": [{ "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36 }, { "type": "null" }]
        },
        "received_at": {
          "description": "The Portal's receive time, UTC, exactly YYYY-MM-DDTHH:MM:SS.sssZ.",
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "format": "date-time"
        },
        "kind": { "type": "string", "const": "dashboard" },
        "counts": {
          "description": "What was sent. areas, topics, cards and tickets come only with a dashboard/2 send (features up to 1,000 and items up to 5,000 there). Since 1.6.0 a timeline/1 send counts features (every row: the features and their changes and bugs), items (its to-dos), areas and pins.",
          "type": "object",
          "additionalProperties": false,
          "required": ["features", "items", "client_contacts"],
          "properties": {
            "features": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "items": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "client_contacts": { "type": "integer", "minimum": 0, "maximum": 200 },
            "areas": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "topics": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "cards": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "tickets": { "description": "The tickets on the Board cards, all cards together.", "type": "integer", "minimum": 0 },
            "pins": { "description": "Since 1.6.0, timeline/1 only: how many pins.", "type": "integer", "minimum": 0, "maximum": 1000000 }
          }
        },
        "dry_run": { "type": "boolean" },
        "client_view": {
          "description": "On a dry run: the Client view of what was sent. client_dashboard_1 for a dashboard/1 send, client_dashboard_2 for a dashboard/2 send, client_timeline_1 for a timeline/1 send (since 1.6.0).",
          "anyOf": [{ "$ref": "#/$defs/client_dashboard_1" }, { "$ref": "#/$defs/client_dashboard_2" }, { "$ref": "#/$defs/client_timeline_1" }]
        },
        "client_contact_names": {
          "description": "The names of the Client contacts sent, so the BA can check them before sending.",
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "pages_removed": {
          "description": "Since 1.3.0. Only for a dashboard/2 send (since 1.6.0 also a timeline/1 send) that carries clarification_pages (then always, maybe empty): the pages of this Portal project that this send hides from the Client because they are not in the list. On a dry run, the pages it would hide. Pages already hidden by an earlier send are not listed. For the BA only (admin).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slug", "title"],
            "properties": {
              "slug": {
                "description": "The page's slug.",
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "title": {
                "description": "The page name of its latest Round.",
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        }
      },
      "if": { "properties": { "dry_run": { "const": true } }, "required": ["dry_run"] },
      "then": {
        "required": ["client_view", "client_contact_names"],
        "properties": { "publish_id": { "type": "null" }, "client_view": true, "client_contact_names": true }
      },
      "else": {
        "properties": { "publish_id": { "type": "string" }, "client_view": false, "client_contact_names": false }
      }
    },
    "client_dashboard_1": {
      "description": "ClientDashboard (AD-4), the view of a dashboard/1 send: only client and id fields, plus the derived waitingOnYou, onAgenda, hiddenByDoneFilter and page. Items with no Feature, an unsent Feature, or awaiting with no matching contact are left out.",
      "type": "object",
      "additionalProperties": false,
      "required": ["areas", "release_rows", "features", "items"],
      "properties": {
        "areas": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "release_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "released"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 100 },
              "released": { "type": "boolean" }
            }
          }
        },
        "features": {
          "type": "array",
          "maxItems": 300,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "summary", "stage", "map_area", "hiddenByDoneFilter", "page"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 40 },
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "short": { "type": "string", "minLength": 1, "maxLength": 40 },
              "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "open": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 500 }
              },
              "stage": { "type": "string", "enum": ["concept", "spec", "ready", "dev", "qa", "done"] },
              "map_area": { "type": "string", "minLength": 1, "maxLength": 100 },
              "releases": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 100 }
              },
              "hiddenByDoneFilter": { "type": "boolean" },
              "page": {
                "description": "The Feature's Clarification page. Always null until Epic 4 (shown as Questions coming).",
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["slug", "answered", "total"],
                    "properties": {
                      "slug": { "type": "string", "minLength": 1, "maxLength": 80 },
                      "answered": { "type": "integer", "minimum": 0 },
                      "total": { "type": "integer", "minimum": 0 }
                    }
                  }
                ]
              }
            }
          }
        },
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "feature", "title", "waitingOnYou", "onAgenda"],
            "properties": {
              "key": { "type": "string", "minLength": 12, "maxLength": 12, "pattern": "^[0-9a-f]{12}$" },
              "feature": {
                "description": "The id of the Feature the Item sits under (an id value).",
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "title": { "type": "string", "minLength": 1, "maxLength": 300 },
              "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "how_to_send": { "type": "string", "minLength": 1, "maxLength": 300 },
              "waitingOnYou": { "type": "boolean" },
              "onAgenda": { "type": "boolean" }
            }
          }
        }
      }
    },
    "client_dashboard_2": {
      "description": "ClientDashboard2, the view of a dashboard/2 send: everything but the envelope, the Client contacts and clar_url, plus the derived waitingOnYou, onAgenda, hiddenByDoneFilter (Features and cards) and page. Every Item is kept; waitingOnYou is true only for a waiting Item whose first person is a Client contact.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jira_base",
        "areas",
        "features",
        "topics",
        "items",
        "releases",
        "cards"
      ],
      "properties": {
        "jira_base": {
          "description": "The Jira site address, https:// only. Null only on a view read from a stored dashboard/1.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 9,
              "maxLength": 2000,
              "pattern": "^https://[^\\s]+(?![\\s\\S])",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "areas": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "quiet"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "quiet": {
                "type": "boolean"
              },
              "special": {
                "type": "string",
                "enum": [
                  "no_area",
                  "not_linked"
                ]
              },
              "jira": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "done",
                  "in_progress",
                  "open"
                ],
                "properties": {
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "done": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "in_progress": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "open": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "last_done": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 10,
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                    "format": "date"
                  },
                  "shipped": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "key",
                        "summary",
                        "date"
                      ],
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 3,
                          "maxLength": 50,
                          "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+(?![\\s\\S])"
                        },
                        "summary": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        },
                        "date": {
                          "type": "string",
                          "minLength": 10,
                          "maxLength": 10,
                          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                          "format": "date"
                        }
                      }
                    }
                  },
                  "open_tickets": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "key",
                        "summary",
                        "status",
                        "stage"
                      ],
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 3,
                          "maxLength": 50,
                          "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+(?![\\s\\S])"
                        },
                        "summary": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        },
                        "status": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "stage": {
                          "type": "string",
                          "enum": [
                            "concept",
                            "spec",
                            "ready",
                            "dev",
                            "qa",
                            "done"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "features": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "area",
              "title",
              "summary",
              "stage",
              "tickets",
              "hiddenByDoneFilter",
              "page"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "area": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "short": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "open": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "answered": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "done",
                  "total"
                ],
                "properties": {
                  "done": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "stage": {
                "type": "string",
                "enum": [
                  "concept",
                  "spec",
                  "ready",
                  "dev",
                  "qa",
                  "done"
                ]
              },
              "done_date": {
                "type": "string",
                "minLength": 10,
                "maxLength": 10,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "format": "date"
              },
              "tickets": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "$ref": "#/$defs/client_ticket"
                }
              },
              "hiddenByDoneFilter": {
                "type": "boolean"
              },
              "page": {
                "description": "The Feature's Clarification page. Always null until Epic 4 (shown as Questions coming).",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "slug",
                      "answered",
                      "total"
                    ],
                    "properties": {
                      "slug": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "answered": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "total": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "topics": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "area",
              "title",
              "stage",
              "tickets"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "area": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "stage": {
                "type": "string",
                "enum": [
                  "concept",
                  "spec",
                  "ready",
                  "dev",
                  "qa",
                  "done"
                ]
              },
              "tickets": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "$ref": "#/$defs/client_ticket"
                }
              }
            }
          }
        },
        "items": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "kind",
              "parent",
              "title",
              "waitingOnYou",
              "onAgenda"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 12,
                "maxLength": 12,
                "pattern": "^[0-9a-f]{12}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "waiting",
                  "agenda"
                ]
              },
              "parent": {
                "description": "The id of the Feature or topic the Item sits under (an id value).",
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "who": {
                "description": "Absent only on a view read from a stored dashboard/1.",
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "since": {
                "description": "Absent only on a view read from a stored dashboard/1.",
                "type": "string",
                "minLength": 10,
                "maxLength": 10,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "format": "date"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "how_to_send": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "waitingOnYou": {
                "type": "boolean"
              },
              "onAgenda": {
                "type": "boolean"
              }
            }
          }
        },
        "releases": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "released",
              "overdue"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "date": {
                "type": "string",
                "minLength": 10,
                "maxLength": 10,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "format": "date"
              },
              "released": {
                "type": "boolean"
              },
              "overdue": {
                "type": "boolean"
              }
            }
          }
        },
        "cards": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "area",
              "release",
              "title",
              "stage",
              "blocked",
              "tickets",
              "hiddenByDoneFilter"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "kind": {
                "type": "string",
                "enum": [
                  "feature",
                  "epic",
                  "other"
                ]
              },
              "area": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "release": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "stage": {
                "type": "string",
                "enum": [
                  "concept",
                  "spec",
                  "ready",
                  "dev",
                  "qa",
                  "done"
                ]
              },
              "blocked": {
                "type": "boolean"
              },
              "done_date": {
                "type": "string",
                "minLength": 10,
                "maxLength": 10,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "format": "date"
              },
              "feature": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "epic": {
                "type": "string",
                "minLength": 3,
                "maxLength": 50,
                "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+(?![\\s\\S])"
              },
              "tickets": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "$ref": "#/$defs/client_ticket"
                }
              },
              "hiddenByDoneFilter": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "client_timeline_1": {"description": "ClientTimeline1 (since 1.6.0), the view of a timeline/1 send: the send as it is, without the envelope, client_contacts and clarification_pages. Since 1.8.0 it may carry suggestion_status; since 1.9.0 upcoming; since 1.10.0 a row's kind, asked, figma and figmaWhere, and a change's or bug's figma and figmaWhere.", "type": "object", "additionalProperties": false, "required": ["product", "today", "start", "built", "groups", "pins", "releases"], "properties": {"product": {"type": "object", "additionalProperties": false, "required": ["name", "tagWord", "tracker", "ba", "footer"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 200}, "tagWord": {"type": "string", "minLength": 1, "maxLength": 40}, "tracker": {"type": "string", "minLength": 1, "maxLength": 40}, "workLink": {"type": "string", "minLength": 9, "maxLength": 2000, "pattern": "^https://[^\\s]+(?![\\s\\S])", "format": "uri"}, "ba": {"type": "string", "minLength": 1, "maxLength": 100}, "footer": {"type": "string", "minLength": 0, "maxLength": 5000}}}, "today": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"}, "start": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"}, "from": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"}, "built": {"type": "string", "minLength": 1, "maxLength": 40}, "groups": {"type": "array", "maxItems": 200, "items": {"type": "object", "additionalProperties": false, "required": ["name", "areas"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 300}, "areas": {"type": "array", "maxItems": 500, "items": {"type": "object", "additionalProperties": false, "required": ["name", "features"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 300}, "features": {"type": "array", "maxItems": 5000, "items": {"