Length": 1, "maxLength": 2000}, "figmaWhere": {"type": "string", "minLength": 1, "maxLength": 500}, "requests": {"type": "array", "maxItems": 500, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "title", "stages", "work"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 300}, "kind": {"type": "string", "enum": ["sub-feature", "change", "improvement", "bug"]}, "title": {"type": "string", "minLength": 1, "maxLength": 1000}, "stages": {"type": "array", "maxItems": 50, "items": {"type": "object", "additionalProperties": false, "required": ["stage", "from"], "properties": {"stage": {"type": "string", "enum": ["concept", "spec", "design", "ready", "dev", "qa", "done", "live"]}, "from": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"}}}}, "work": {"type": "array", "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "status"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 300}, "title": {"type": "string", "minLength": 0, "maxLength": 2000}, "status": {"type": "string", "minLength": 0, "maxLength": 200}, "url": {"type": "string", "minLength": 9, "maxLength": 2000, "pattern": "^https://[^\\s]+(?![\\s\\S])", "format": "uri"}, "done": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"}}}}, "askedIn": {"type": "string", "minLength": 1, "maxLength": 100}, "askedBy": {"type": "string", "minLength": 1, "maxLength": 200}, "asked": {"type": "string", "minLength": 1, "maxLength": 2000}, "about": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}, "note": {"type": "string", "minLength": 1, "maxLength": 2000}, "self": {"type": "string", "minLength": 1, "maxLength": 300}, "guess": {"type": "boolean"}, "merged": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"}, "splitOff": {"type": "string", "minLength": 1, "maxLength": 300}, "figma": {"type": "string", "minLength": 1, "maxLength": 2000}, "figmaWhere": {"type": "string", "minLength": 1, "maxLength": 500}, "tags": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 200}}}}}}}}, "link": {"type": "object", "additionalProperties": false, "required": ["label", "url"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 200}, "url": {"type": "string", "minLength": 9, "maxLength": 2000, "pattern": "^https://[^\\s]+(?![\\s\\S])", "format": "uri"}}}}}}}}}, "pins": {"type": "array", "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["id", "date", "kind", "title"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 100}, "date": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"}, "kind": {"type": "string", "enum": ["call", "email", "comments", "doc", "page", "idea"]}, "title": {"type": "string", "minLength": 1, "maxLength": 500}, "subject": {"type": "string", "minLength": 1, "maxLength": 1000}, "ref": {"type": "string", "minLength": 1, "maxLength": 100}, "people": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 100}}, "staff": {"type": "integer", "minimum": 0}, "minutes": {"type": "integer", "minimum": 0}, "summary": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 5000}}, "decided": {"type": "array", "maxItems": 500, "items": {"type": "object", "additionalProperties": false, "required": ["title", "page", "how"], "properties": {"title": {"type": "string", "minLength": 0, "maxLength": 2000}, "page": {"type": "string", "minLength": 0, "maxLength": 300}, "how": {"type": "string", "minLength": 0, "maxLength": 300}}}}, "owes": {"type": "array", "maxItems": 500, "items": {"type": "object", "additionalProperties": false, "required": ["who", "text"], "properties": {"who": {"type": "string", "minLength": 0, "maxLength": 200}, "text": {"type": "string", "minLength": 0, "maxLength": 10000}}}}}}}, "releases": {"type": "array", "maxItems": 2000, "items": {"type": "object", "additionalProperties": false, "required": ["name", "date"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 255}, "date": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"}}}}, "suggestion_status": {"type": "array", "maxItems": 100000, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "reason"], "properties": {"id": {"type": "string", "minLength": 36, "maxLength": 36, "format": "uuid"}, "status": {"type": "string", "enum": ["accepted", "declined"]}, "reason": {"type": "string", "minLength": 0, "maxLength": 2000}}}}, "upcoming": {"type": "array", "maxItems": 500, "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "kind"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 100}, "title": {"type": "string", "minLength": 1, "maxLength": 300}, "kind": {"type": "string", "enum": ["deadline", "release", "planned"]}, "date": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"}, "after": {"type": "string", "minLength": 1, "maxLength": 300}, "needs": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 300}}, "what": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}, "who": {"type": "string", "minLength": 1, "maxLength": 200}}, "not": {"required": ["date", "after"], "properties": {"date": {"type": "string"}, "after": {"type": "string"}}}}}}},
    "client_ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "summary",
        "status",
        "stage"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 3,
          "maxLength": 50,
          "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+(?![\\s\\S])"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "stage": {
          "type": "string",
          "enum": [
            "concept",
            "spec",
            "ready",
            "dev",
            "qa",
            "done"
          ]
        },
        "assignee": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "page": {
      "description": "The page form: the 200 reply to POST /api/v1/publish/page. On a dry run (?dry_run=1) it also carries client_view, and nothing is stored or logged. A page carries no contacts, so there is no client_contact_names.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "publish_id", "received_at", "kind", "counts", "round", "dry_run"],
      "properties": {
        "contract": { "type": "string", "const": "publish-reply/1" },
        "publish_id": {
          "description": "The id of the stored Round version (UUID v7). On a dry run nothing is stored, so it is null.",
          "anyOf": [{ "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36 }, { "type": "null" }]
        },
        "received_at": {
          "description": "The Portal's receive time, UTC, exactly YYYY-MM-DDTHH:MM:SS.sssZ.",
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "format": "date-time"
        },
        "kind": { "type": "string", "const": "page" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["questions", "screenshots"],
          "properties": {
            "questions": { "type": "integer", "minimum": 0, "maximum": 50 },
            "screenshots": { "type": "integer", "minimum": 0, "maximum": 30 }
          }
        },
        "round": {
          "description": "The Round this Publish made or replaced. new is true when the store_key was new for the page (on a dry run: would be new).",
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "label", "new"],
          "properties": {
            "key": { "description": "The store_key.", "type": "string", "minLength": 1, "maxLength": 100 },
            "label": { "description": "The Round label (the page's round field).", "type": "string", "minLength": 1, "maxLength": 200 },
            "new": { "type": "boolean" }
          }
        },
        "dry_run": { "type": "boolean" },
        "client_view": { "$ref": "#/$defs/client_round" }
      },
      "if": { "properties": { "dry_run": { "const": true } }, "required": ["dry_run"] },
      "then": {
        "required": ["client_view"],
        "properties": { "publish_id": { "type": "null" }, "client_view": true }
      },
      "else": {
        "properties": { "publish_id": { "type": "string" }, "client_view": false }
      }
    },
    "client_round": {
      "description": "ClientRound (AD-4): only client and id fields of the page. Screens are { media, cap }, the hero first. media is /media/<uuid> on a stored Round and null on a dry run, because a dry run stores no file.",
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "round", "design", "decisions", "questions"],
      "properties": {
        "slug": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "round": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "problem": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "solution": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "design": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "screens"],
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 80 },
            "more_label": { "type": "string", "minLength": 1, "maxLength": 80 },
            "summary": { "type": "string", "minLength": 1, "maxLength": 700 },
            "detail": { "type": "string", "minLength": 1, "maxLength": 3000 },
            "screens": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/client_screen" } }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "date": {
                "type": "string",
                "minLength": 10,
                "maxLength": 10,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "format": "date"
              },
              "who": { "type": "string", "minLength": 1, "maxLength": 200 },
              "how": { "type": "string", "minLength": 1, "maxLength": 300 },
              "title": { "type": "string", "minLength": 1, "maxLength": 300 },
              "detail": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "questions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "body", "options", "screens"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 80 },
              "section": { "type": "string", "minLength": 1, "maxLength": 300 },
              "title": { "type": "string", "minLength": 1, "maxLength": 300 },
              "meta": { "type": "string", "minLength": 1, "maxLength": 300 },
              "body": { "type": "string", "minLength": 1, "maxLength": 5000 },
              "body2": { "type": "string", "minLength": 1, "maxLength": 5000 },
              "snag": { "type": "string", "minLength": 1, "maxLength": 5000 },
              "quote": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
                  "cite": { "type": "string", "minLength": 1, "maxLength": 1000 }
                }
              },
              "note": { "type": "string", "minLength": 1, "maxLength": 300 },
              "note_placeholder": { "type": "string", "minLength": 1, "maxLength": 300 },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["v", "t"],
                  "properties": {
                    "v": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "t": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "d": { "type": "string", "minLength": 1, "maxLength": 1000 },
                    "rec": { "type": "boolean" }
                  }
                }
              },
              "screens": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/client_screen" } }
            }
          }
        }
      }
    },
    "client_screen": {
      "description": "A screen in the Client view: its media address, caption and (since 1.7.0) Figma link. Never its file name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["media"],
      "properties": {
        "media": {
          "description": "/media/<uuid> on a stored Round; null on a dry run.",
          "anyOf": [
            { "type": "string", "minLength": 43, "maxLength": 43, "pattern": "^/media/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            { "type": "null" }
          ]
        },
        "cap": { "type": "string", "minLength": 1, "maxLength": 300 },
        "figma": { "description": "Since 1.7.0. The screen's Figma link, for the Open in Figma button.", "type": "string", "minLength": 22, "maxLength": 2000, "pattern": "^https://www\\.figma\\.com/[^\\x00-\\x20\\x7f]*(?![\\s\\S])" }
      }
    }
  }
}
