{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Relevant-S/ba-tools/skills/portal-publish/contract/publish-reply-1.schema.json",
  "title": "publish-reply/1",
  "description": "The 200 reply to a Publish. kind says which form: dashboard (POST /api/v1/publish/dashboard) or page (POST /api/v1/publish/page). On a dry run (?dry_run=1) it also carries client_view (and, for a Dashboard, client_contact_names), and nothing is stored or logged. The top level only picks the form by kind; each form in $defs is a closed object.",
  "type": "object",
  "if": { "properties": { "kind": { "const": "page" } }, "required": ["kind"] },
  "then": { "$ref": "#/$defs/page" },
  "else": { "$ref": "#/$defs/dashboard" },
  "$defs": {
    "dashboard": {
      "description": "The Dashboard form: the 200 reply to POST /api/v1/publish/dashboard. On a dry run it also carries client_view and client_contact_names.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "publish_id", "received_at", "kind", "counts", "dry_run"],
      "properties": {
        "contract": { "type": "string", "const": "publish-reply/1" },
        "publish_id": {
          "description": "The id of the stored version (UUID v7). On a dry run nothing is stored, so it is null.",
          "anyOf": [{ "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36 }, { "type": "null" }]
        },
        "received_at": {
          "description": "The Portal's receive time, UTC, exactly YYYY-MM-DDTHH:MM:SS.sssZ.",
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "format": "date-time"
        },
        "kind": { "type": "string", "const": "dashboard" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["features", "items", "client_contacts"],
          "properties": {
            "features": { "type": "integer", "minimum": 0, "maximum": 300 },
            "items": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "client_contacts": { "type": "integer", "minimum": 0, "maximum": 200 }
          }
        },
        "dry_run": { "type": "boolean" },
        "client_view": {
          "description": "ClientDashboard (AD-4): only client and id fields, plus the derived waitingOnYou, onAgenda, hiddenByDoneFilter and page. Items with no Feature, an unsent Feature, or awaiting with no matching contact are left out.",
          "type": "object",
          "additionalProperties": false,
          "required": ["areas", "release_rows", "features", "items"],
          "properties": {
            "areas": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 100 }
            },
            "release_rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "released"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "released": { "type": "boolean" }
                }
              }
            },
            "features": {
              "type": "array",
              "maxItems": 300,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "summary", "stage", "map_area", "hiddenByDoneFilter", "page"],
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "short": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
                  "open": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1, "maxLength": 500 }
                  },
                  "stage": { "type": "string", "enum": ["concept", "spec", "ready", "dev", "qa", "done"] },
                  "map_area": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "releases": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1, "maxLength": 100 }
                  },
                  "hiddenByDoneFilter": { "type": "boolean" },
                  "page": {
                    "description": "The Feature's Clarification page. Always null until Epic 4 (shown as Questions coming).",
                    "anyOf": [
                      { "type": "null" },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["slug", "answered", "total"],
                        "properties": {
                          "slug": { "type": "string", "minLength": 1, "maxLength": 80 },
                          "answered": { "type": "integer", "minimum": 0 },
                          "total": { "type": "integer", "minimum": 0 }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "items": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "feature", "title", "waitingOnYou", "onAgenda"],
                "properties": {
                  "key": { "type": "string", "minLength": 12, "maxLength": 12, "pattern": "^[0-9a-f]{12}$" },
                  "feature": {
                    "description": "The id of the Feature the Item sits under (an id value).",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "title": { "type": "string", "minLength": 1, "maxLength": 300 },
                  "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
                  "how_to_send": { "type": "string", "minLength": 1, "maxLength": 300 },
                  "waitingOnYou": { "type": "boolean" },
                  "onAgenda": { "type": "boolean" }
                }
              }
            }
          }
        },
        "client_contact_names": {
          "description": "The names of the Client contacts sent, so the BA can check them before sending.",
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      },
      "if": { "properties": { "dry_run": { "const": true } }, "required": ["dry_run"] },
      "then": {
        "required": ["client_view", "client_contact_names"],
        "properties": { "publish_id": { "type": "null" }, "client_view": true, "client_contact_names": true }
      },
      "else": {
        "properties": { "publish_id": { "type": "string" }, "client_view": false, "client_contact_names": false }
      }
    },
    "page": {
      "description": "The page form: the 200 reply to POST /api/v1/publish/page. On a dry run (?dry_run=1) it also carries client_view, and nothing is stored or logged. A page carries no contacts, so there is no client_contact_names.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "publish_id", "received_at", "kind", "counts", "round", "dry_run"],
      "properties": {
        "contract": { "type": "string", "const": "publish-reply/1" },
        "publish_id": {
          "description": "The id of the stored Round version (UUID v7). On a dry run nothing is stored, so it is null.",
          "anyOf": [{ "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36 }, { "type": "null" }]
        },
        "received_at": {
          "description": "The Portal's receive time, UTC, exactly YYYY-MM-DDTHH:MM:SS.sssZ.",
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "format": "date-time"
        },
        "kind": { "type": "string", "const": "page" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["questions", "screenshots"],
          "properties": {
            "questions": { "type": "integer", "minimum": 0, "maximum": 50 },
            "screenshots": { "type": "integer", "minimum": 0, "maximum": 30 }
          }
        },
        "round": {
          "description": "The Round this Publish made or replaced. new is true when the store_key was new for the page (on a dry run: would be new).",
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "label", "new"],
          "properties": {
            "key": { "description": "The store_key.", "type": "string", "minLength": 1, "maxLength": 100 },
            "label": { "description": "The Round label (the page's round field).", "type": "string", "minLength": 1, "maxLength": 200 },
            "new": { "type": "boolean" }
          }
        },
        "dry_run": { "type": "boolean" },
        "client_view": { "$ref": "#/$defs/client_round" }
      },
      "if": { "properties": { "dry_run": { "const": true } }, "required": ["dry_run"] },
      "then": {
        "required": ["client_view"],
        "properties": { "publish_id": { "type": "null" }, "client_view": true }
      },
      "else": {
        "properties": { "publish_id": { "type": "string" }, "client_view": false }
      }
    },
    "client_round": {
      "description": "ClientRound (AD-4): only client and id fields of the page. Screens are { media, cap }, the hero first. media is /media/<uuid> on a stored Round and null on a dry run, because a dry run stores no file.",
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "round", "design", "decisions", "questions"],
      "properties": {
        "slug": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "round": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "problem": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "solution": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "design": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "screens"],
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 80 },
            "more_label": { "type": "string", "minLength": 1, "maxLength": 80 },
            "summary": { "type": "string", "minLength": 1, "maxLength": 700 },
            "detail": { "type": "string", "minLength": 1, "maxLength": 3000 },
            "screens": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/client_screen" } }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "date": {
                "type": "string",
                "minLength": 10,
                "maxLength": 10,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "format": "date"
              },
              "who": { "type": "string", "minLength": 1, "maxLength": 200 },
              "how": { "type": "string", "minLength": 1, "maxLength": 300 },
              "title": { "type": "string", "minLength": 1, "maxLength": 300 },
              "detail": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "questions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "body", "options", "screens"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 80 },
              "section": { "type": "string", "minLength": 1, "maxLength": 300 },
              "title": { "type": "string", "minLength": 1, "maxLength": 300 },
              "meta": { "type": "string", "minLength": 1, "maxLength": 300 },
              "body": { "type": "string", "minLength": 1, "maxLength": 5000 },
              "body2": { "type": "string", "minLength": 1, "maxLength": 5000 },
              "snag": { "type": "string", "minLength": 1, "maxLength": 5000 },
              "quote": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
                  "cite": { "type": "string", "minLength": 1, "maxLength": 1000 }
                }
              },
              "note": { "type": "string", "minLength": 1, "maxLength": 300 },
              "note_placeholder": { "type": "string", "minLength": 1, "maxLength": 300 },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["v", "t"],
                  "properties": {
                    "v": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "t": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "d": { "type": "string", "minLength": 1, "maxLength": 1000 },
                    "rec": { "type": "boolean" }
                  }
                }
              },
              "screens": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/client_screen" } }
            }
          }
        }
      }
    },
    "client_screen": {
      "description": "A screen in the Client view: its media address and caption. Never its file name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["media"],
      "properties": {
        "media": {
          "description": "/media/<uuid> on a stored Round; null on a dry run.",
          "anyOf": [
            { "type": "string", "minLength": 43, "maxLength": 43, "pattern": "^/media/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            { "type": "null" }
          ]
        },
        "cap": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    }
  }
}
