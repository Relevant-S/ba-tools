{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Relevant-S/ba-tools/skills/portal-publish/contract/answers-2.schema.json",
  "title": "answers/2",
  "description": "Since 1.4.0. The 200 reply to POST /api/v1/answers/reserve when the request's accept list holds answers/2 (reserve-request/1). answers/1 plus updates: the Client's saves on Waiting and agenda Items (a note, the Resolved tick, or both). The Portal puts every sent Answer and every save not yet handed out into one new batch, held until reserved_until. With nothing to hand out, batch_id and reserved_until are null, both lists are empty and nothing is written. Order of answers: page slug, Round first published, Question position, sent_at. Order of updates: sent_at, then id. One ack (ack-request/1) confirms both.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "batch_id", "reserved_until", "last_fetched_at", "answers", "updates"],
  "properties": {
    "contract": { "type": "string", "const": "answers/2" },
    "batch_id": {
      "description": "The batch to acknowledge (UUID v7), or null when there is nothing to hand out.",
      "anyOf": [{ "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36 }, { "type": "null" }]
    },
    "reserved_until": {
      "description": "Until when the batch is held, UTC, exactly YYYY-MM-DDTHH:MM:SS.sssZ; null with no batch.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "format": "date-time"
        },
        { "type": "null" }
      ]
    },
    "last_fetched_at": {
      "description": "When Answers were last handed out (a batch acknowledged), UTC; null if never.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "format": "date-time"
        },
        { "type": "null" }
      ]
    },
    "answers": {
      "description": "The sent Answers in the batch.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sent_at", "person", "page", "round", "question", "option", "note", "replaces"],
        "description": "One sent Answer. It has an option, a note, or both.",
        "not": { "required": ["option", "note"], "properties": { "option": { "type": "null" }, "note": { "type": "null" } } },
        "properties": {
          "id": {
            "description": "The Answer's id (UUID v7).",
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36
          },
          "sent_at": {
            "description": "When the person sent it, UTC.",
            "type": "string",
            "minLength": 24,
            "maxLength": 24,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
            "format": "date-time"
          },
          "person": {
            "description": "Who sent it. A removed person's Answers still come, with name and email.",
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "email"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 100 },
              "email": { "type": "string", "minLength": 3, "maxLength": 254, "format": "email" }
            }
          },
          "page": {
            "description": "The Clarification page.",
            "type": "object",
            "additionalProperties": false,
            "required": ["slug", "title"],
            "properties": {
              "slug": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])" },
              "title": {
                "description": "The page name, from the Round's newest version.",
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          },
          "round": {
            "description": "The Round the Answer was sent on.",
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "published_at"],
            "properties": {
              "key": { "description": "The Round's store_key.", "type": "string", "minLength": 1, "maxLength": 100 },
              "label": { "type": "string", "minLength": 1, "maxLength": 200 },
              "published_at": {
                "description": "When the Round was first published, UTC.",
                "type": "string",
                "minLength": 24,
                "maxLength": 24,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
                "format": "date-time"
              }
            }
          },
          "question": {
            "description": "The Question, from the Round's newest version.",
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "position"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 80 },
              "title": { "type": "string", "minLength": 1, "maxLength": 300 },
              "position": {
                "description": "The Question's place on the page, counting from 1.",
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              }
            }
          },
          "option": {
            "description": "The chosen option, or null when the person sent only a note.",
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["v", "text"],
                "properties": {
                  "v": { "type": "string", "minLength": 1, "maxLength": 80 },
                  "text": { "type": "string", "minLength": 1, "maxLength": 200 }
                }
              },
              { "type": "null" }
            ]
          },
          "note": {
            "description": "The person's note, or null.",
            "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 5000 }, { "type": "null" }]
          },
          "replaces": {
            "description": "The same person's newest earlier sent Answer on the same Round and Question, or null.",
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "sent_at", "person_name", "option", "note"],
                "not": { "required": ["option", "note"], "properties": { "option": { "type": "null" }, "note": { "type": "null" } } },
                "properties": {
                  "id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36 },
                  "sent_at": {
                    "type": "string",
                    "minLength": 24,
                    "maxLength": 24,
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
                    "format": "date-time"
                  },
                  "person_name": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "option": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["v", "text"],
                        "properties": {
                          "v": { "type": "string", "minLength": 1, "maxLength": 80 },
                          "text": { "type": "string", "minLength": 1, "maxLength": 200 }
                        }
                      },
                      { "type": "null" }
                    ]
                  },
                  "note": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 5000 }, { "type": "null" }] }
                }
              },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "updates": {
      "description": "The Client's saves on Items in the batch. One entry per save; the latest save of an Item says whether it is resolved.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sent_at", "person", "item", "note", "resolved"],
        "description": "One save on one Item's Update box.",
        "properties": {
          "id": {
            "description": "The save's id (UUID v7).",
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36
          },
          "sent_at": {
            "description": "When the person saved it, UTC.",
            "type": "string",
            "minLength": 24,
            "maxLength": 24,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
            "format": "date-time"
          },
          "person": {
            "description": "Who saved it. A removed person's saves still come, with name and email.",
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "email"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 100 },
              "email": { "type": "string", "minLength": 3, "maxLength": 254, "format": "email" }
            }
          },
          "item": {
            "description": "The Item, as the BA page names it.",
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "kind", "title"],
            "properties": {
              "key": {
                "description": "The BA page's item key: the first 12 hex characters of sha1(\"<kind>|<title>\") (title trimmed, UTF-8). Not the dashboard/2 key, which holds the parent too.",
                "type": "string",
                "minLength": 12,
                "maxLength": 12,
                "pattern": "^[0-9a-f]{12}$"
              },
              "kind": { "type": "string", "enum": ["waiting", "agenda"] },
              "title": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          },
          "note": {
            "description": "The note, plain text, or null when the person only changed the tick.",
            "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 2000 }, { "type": "null" }]
          },
          "resolved": {
            "description": "The Resolved tick as it was at this save.",
            "type": "boolean"
          }
        }
      }
    }
  },
  "if": { "properties": { "batch_id": { "type": "null" } }, "required": ["batch_id"] },
  "then": {
    "properties": {
      "reserved_until": { "type": "null" },
      "answers": { "type": "array", "maxItems": 0 },
      "updates": { "type": "array", "maxItems": 0 }
    }
  },
  "else": {
    "description": "A batch holds at least one Answer or one update. Written as not (both empty), so the error has one path (the whole reply) in every checker.",
    "properties": { "reserved_until": { "type": "string" } },
    "not": {
      "properties": { "answers": { "type": "array", "maxItems": 0 }, "updates": { "type": "array", "maxItems": 0 } },
      "required": ["answers", "updates"]
    }
  }
}
