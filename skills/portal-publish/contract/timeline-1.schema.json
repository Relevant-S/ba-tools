                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "x-visibility": "client"
                      },
                      "page": {
                        "description": "Its Clarification page on this Portal: the page's slug (in place of the BA page's artifact link). When clarification_pages is sent, it is one of them (check known_page).",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
                        "x-visibility": "id"
                      },
                      "clarLabel": {
                        "description": "The clarification page button's words (\"Clarification page — V3, all answered\").",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300,
                        "x-visibility": "client"
                      },
                      "openQ": {
                        "description": "Open questions.",
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "x-visibility": "client"
                      },
                      "todos": {
                        "description": "Its to-dos, waiting and agenda items, oldest first.",
                        "type": "array",
                        "maxItems": 500,
                        "items": {
                          "description": "One to-do: a waiting, agenda or BA to-do item of the dashboard, as the BA page shows it.",
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "key",
                            "kind",
                            "title"
                          ],
                          "properties": {
                            "key": {
                              "description": "The BA page's item key: the first 12 hex characters of sha1(\"<kind>|<title>\") (title trimmed, UTF-8), as the dashboard builds it. Notes and Resolved ticks are saved under it. Unique in a send (check unique_item_key).",
                              "type": "string",
                              "minLength": 12,
                              "maxLength": 12,
                              "pattern": "^[0-9a-f]{12}$",
                              "x-visibility": "id"
                            },
                            "id": {
                              "description": "The dashboard's own short id (A21, T66).",
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 40,
                              "x-visibility": "id"
                            },
                            "kind": {
                              "description": "waiting (someone owes an answer), agenda (for the next call) or todo (the BA's own to-do).",
                              "type": "string",
                              "enum": [
                                "waiting",
                                "agenda",
                                "todo"
                              ],
                              "x-visibility": "client"
                            },
                            "title": {
                              "description": "The to-do in one line.",
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 500,
                              "x-visibility": "client"
                            },
                            "who": {
                              "description": "Who it waits on, as the dashboard writes it (\"Sam Carter\", \"Vadim\"). May be empty.",
                              "type": "string",
                              "minLength": 0,
                              "maxLength": 200,
                              "x-visibility": "client"
                            },
                            "since": {
                              "description": "When it was first listed. YYYY-MM-DD.",
                              "type": "string",
                              "minLength": 10,
                              "maxLength": 10,
                              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                              "format": "date",
                              "x-visibility": "client"
                            },
                            "age": {
                              "description": "How many days old it was on the build day.",
                              "type": "integer",
                              "minimum": 0,
                              "x-visibility": "client"
                            },
                            "status": {
                              "description": "open, hot or old, as the dashboard marks it.",
                              "type": "string",
                              "enum": [
                                "open",
                                "hot",
                                "old"
                              ],
                              "x-visibility": "client"
                            },
                            "prod": {
                              "description": "The dashboard's product for it (AcmeLending, Both).",
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 100,
                              "x-visibility": "client"
