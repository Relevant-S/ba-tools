{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Relevant-S/ba-tools/skills/portal-publish/contract/timeline-1.schema.json",
  "title": "timeline/1",
  "description": "Since 1.6.0. One Timeline send for one product (one Portal project): the BA's Timeline page data (ba-tools skills/timeline, build.py --json) with the envelope, client_contacts and clarification_pages added; a feature names its Portal Clarification page by slug (page) in place of the artifact link (clar); clar, pages, dashboardUrl and pins[].decided[].url are left out. A field the build writes as null is left out. Sent to POST /api/v1/publish/dashboard like dashboard/2; the latest send of either wins. Readable twin: timeline-1.md. x-visibility says who may see each leaf field: client, id, portal or admin.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "sent_at",
    "sent_by",
    "ba_tools_version",
    "product",
    "today",
    "start",
    "built",
    "groups",
    "pins",
    "releases",
    "client_contacts"
  ],
  "properties": {
    "contract": {
      "description": "Which contract this Publish follows. Written by the skill.",
      "type": "string",
      "const": "timeline/1",
      "x-visibility": "admin"
    },
    "sent_at": {
      "description": "When the skill sent it, UTC, exactly YYYY-MM-DDTHH:MM:SS.sssZ.",
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "format": "date-time",
      "x-visibility": "admin"
    },
    "sent_by": {
      "description": "The git user name of the BA who sent it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "x-visibility": "admin"
    },
    "ba_tools_version": {
      "description": "The ba-tools version that sent it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "x-visibility": "admin"
    },
    "source_commit": {
      "description": "The Project repo commit the data came from.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-visibility": "admin"
    },
    "product": {
      "description": "The product.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tagWord",
        "tracker",
        "ba",
        "footer"
      ],
      "properties": {
        "name": {
          "description": "Its name: the title.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-visibility": "client"
        },
        "tagWord": {
          "description": "What a tag is: Release or Phase.",
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "x-visibility": "client"
        },
        "tracker": {
          "description": "Which tracker plug-in built it (jira, github-bmad).",
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "x-visibility": "client"
        },
        "workLink": {
          "description": "The base link of a work item's id. Only https:// links, so a link can never run script.",
          "type": "string",
          "minLength": 9,
          "maxLength": 2000,
          "pattern": "^https://[^\\s]+(?![\\s\\S])",
          "format": "uri",
          "x-visibility": "client"
        },
        "ba": {
          "description": "The BA's first name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "x-visibility": "client"
        },
        "footer": {
          "description": "What the page is built from, for the footer.",
          "type": "string",
          "minLength": 0,
          "maxLength": 5000,
          "x-visibility": "client"
        }
      }
    },
    "today": {
      "description": "The build day. YYYY-MM-DD.",
      "type": "string",
      "minLength": 10,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date",
      "x-visibility": "client"
    },
    "start": {
      "description": "Where the chart starts by default. YYYY-MM-DD.",
      "type": "string",
      "minLength": 10,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date",
      "x-visibility": "client"
    },
    "from": {
      "description": "The earliest feature start, when it is before start. YYYY-MM-DD.",
      "type": "string",
      "minLength": 10,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date",
      "x-visibility": "client"
    },
    "built": {
      "description": "When it was built, as the footer shows it (\"06 Nov 2026, 11:11\").",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "x-visibility": "client"
    },
    "groups": {
      "description": "Area groups → areas → rows. Feature ids unique across them all.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "description": "One area group (\"Getting in\").",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "areas"
        ],
        "properties": {
          "name": {
            "description": "The group's name.",
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "x-visibility": "client"
          },
          "areas": {
            "description": "Its areas.",
            "type": "array",
            "maxItems": 500,
            "items": {
              "description": "One area (\"Sign-in\").",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "features"
              ],
              "properties": {
                "name": {
                  "description": "The area's name.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "x-visibility": "client"
                },
                "features": {
                  "description": "Its rows, in the build's order.",
                  "type": "array",
                  "maxItems": 5000,
                  "items": {
                    "description": "One row: a feature of the dashboard, a spec, or older work from the tracker.",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "label",
                      "stage",
                      "origin",
                      "basis",
                      "desc",
                      "work",
                      "guess",
                      "who",
                      "tags"
                    ],
                    "properties": {
                      "id": {
                        "description": "Its id: the dashboard id, a spec id or a story id. Unique in a send (check unique_feature_id).",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300,
                        "x-visibility": "id"
                      },
                      "label": {
                        "description": "The row name.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000,
                        "x-visibility": "client"
                      },
                      "stage": {
                        "description": "Where it is now.",
                        "type": "string",
                        "enum": [
                          "concept",
                          "spec",
                          "design",
                          "ready",
                          "dev",
                          "qa",
                          "done",
                          "live"
                        ],
                        "x-visibility": "client"
                      },
                      "stages": {
                        "description": "The bar: each stage and the day it started, oldest first.",
                        "type": "array",
                        "maxItems": 50,
                        "items": {
                          "description": "One stage.",
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "stage",
                            "from"
                          ],
                          "properties": {
                            "stage": {
                              "description": "The stage.",
                              "type": "string",
                              "enum": [
                                "concept",
                                "spec",
                                "design",
                                "ready",
                                "dev",
                                "qa",
                                "done",
                                "live"
                              ],
                              "x-visibility": "client"
                            },
                            "from": {
                              "description": "The day it started. YYYY-MM-DD.",
                              "type": "string",
                              "minLength": 10,
                              "maxLength": 10,
                              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                              "format": "date",
                              "x-visibility": "client"
                            }
                          }
                        }
                      },
                      "since": {
                        "description": "When the dashboard first lists it. YYYY-MM-DD.",
                        "type": "string",
                        "minLength": 10,
                        "maxLength": 10,
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                        "format": "date",
                        "x-visibility": "client"
                      },
                      "doneDate": {
                        "description": "When it reached Done. YYYY-MM-DD.",
                        "type": "string",
                        "minLength": 10,
                        "maxLength": 10,
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                        "format": "date",
                        "x-visibility": "client"
                      },
                      "startedBefore": {
                        "description": "It started before the chart's start, on this day. YYYY-MM-DD.",
                        "type": "string",
                        "minLength": 10,
                        "maxLength": 10,
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                        "format": "date",
                        "x-visibility": "client"
                      },
                      "origin": {
                        "description": "dashboard, spec (a spec not on the dashboard) or old-work (an old Jira story or MVP story).",
                        "type": "string",
                        "enum": [
                          "dashboard",
                          "spec",
                          "old-work"
                        ],
                        "x-visibility": "client"
                      },
                      "basis": {
                        "description": "Where the stage dates come from: recorded (by hand), tracker, code (commit list) or none (a faded bar).",
                        "type": "string",
                        "enum": [
                          "recorded",
                          "tracker",
                          "code",
                          "none"
                        ],
                        "x-visibility": "client"
                      },
                      "originNote": {
                        "description": "One line at the top of its panel, for a row not on the dashboard.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "x-visibility": "client"
                      },
                      "basisNote": {
                        "description": "One line above the stage dates.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "x-visibility": "client"
                      },
                      "desc": {
                        "description": "The dashboard's client text, plain. May be empty.",
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 20000,
                        "x-visibility": "client"
                      },
                      "about": {
