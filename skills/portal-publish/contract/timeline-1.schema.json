                              "description": "Placed under this feature by guess.",
                              "type": "boolean",
                              "x-visibility": "client"
                            },
                            "merged": {
                              "description": "When it merged into the feature. YYYY-MM-DD.",
                              "type": "string",
                              "minLength": 10,
                              "maxLength": 10,
                              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                              "format": "date",
                              "x-visibility": "client"
                            },
                            "splitOff": {
                              "description": "It became a feature of its own: that feature's id.",
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 300,
                              "x-visibility": "id"
                            },
                            "tags": {
                              "description": "Releases or phases, only when different from the feature's.",
                              "type": "array",
                              "maxItems": 50,
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200
                              },
                              "x-visibility": "client"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "link": {
                  "description": "Optional: a \"see all in Jira\" link.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "url"
                  ],
                  "properties": {
                    "label": {
                      "description": "The link's words.",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "x-visibility": "client"
                    },
                    "url": {
                      "description": "The link. Only https:// links, so a link can never run script.",
                      "type": "string",
                      "minLength": 9,
                      "maxLength": 2000,
                      "pattern": "^https://[^\\s]+(?![\\s\\S])",
                      "format": "uri",
                      "x-visibility": "client"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "pins": {
      "description": "Calls, emails, comments, documents, page answers, suggestions, oldest first.",
      "type": "array",
      "maxItems": 10000,
      "items": {
        "description": "One pin on the time axis: a call, email, comment batch, document, page answers or suggestion.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "kind",
          "title"
        ],
        "properties": {
          "id": {
            "description": "Its id (2026-10-26-email). Unique in a send (check unique_pin_id).",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "x-visibility": "id"
          },
          "date": {
            "description": "Its day. YYYY-MM-DD.",
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date",
            "x-visibility": "client"
          },
          "kind": {
            "description": "call, email, comments, doc (a file the client sent), page (clarification answers) or idea (a suggestion).",
            "type": "string",
            "enum": [
              "call",
              "email",
              "comments",
              "doc",
              "page",
              "idea"
            ],
            "x-visibility": "client"
          },
          "title": {
            "description": "\"Client call\", \"Email\".",
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "x-visibility": "client"
          },
          "subject": {
            "description": "An email's subject.",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "x-visibility": "client"
          },
          "ref": {
            "description": "The data file's own id for it.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "x-visibility": "id"
          },
          "people": {
            "description": "Who took part (first names).",
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "x-visibility": "client"
          },
          "staff": {
            "description": "How many Relevant people took part.",
            "type": "integer",
            "minimum": 0,
            "x-visibility": "client"
          },
          "minutes": {
            "description": "How long the call was.",
            "type": "integer",
            "minimum": 0,
            "x-visibility": "client"
          },
          "summary": {
            "description": "\"In short\": the summary bullets.",
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "x-visibility": "client"
          },
          "decided": {
            "description": "\"Decided\": decisions from clarification pages made that day.",
            "type": "array",
            "maxItems": 500,
            "items": {
              "description": "One decision.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "page",
                "how"
              ],
              "properties": {
                "title": {
                  "description": "The decision.",
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 2000,
                  "x-visibility": "client"
                },
                "page": {
                  "description": "The clarification page's name.",
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 300,
                  "x-visibility": "client"
                },
                "how": {
                  "description": "How it was decided (\"on the client call\").",
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 300,
                  "x-visibility": "client"
                }
              }
            }
          },
          "owes": {
            "description": "\"To-dos from it\".",
            "type": "array",
            "maxItems": 500,
            "items": {
              "description": "One to-do from it.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "who",
                "text"
              ],
              "properties": {
                "who": {
                  "description": "Who owes it.",
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 200,
                  "x-visibility": "client"
                },
                "text": {
                  "description": "What.",
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 10000,
                  "x-visibility": "client"
                }
              }
            }
          }
        }
      }
    },
    "releases": {
      "description": "Releases: dashed lines on the chart.",
      "type": "array",
      "maxItems": 2000,
      "items": {
        "description": "One release.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "date"
        ],
        "properties": {
          "name": {
            "description": "The release name (copied from the tracker).",
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "x-visibility": "client"
          },
          "date": {
            "description": "Its date. YYYY-MM-DD.",
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date",
            "x-visibility": "client"
          }
        }
      }
    },
    "client_contacts": {
      "description": "Client contacts, from tools.client_contacts, as in dashboard/2: \"Yours first\" on the To-dos tab. Each accepted send replaces the whole list. May be empty. Server only.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "description": "One contact.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "description": "The contact's name.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "x-visibility": "portal"
          },
          "email": {
            "description": "The contact's email.",
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "format": "email",
            "x-visibility": "portal"
          },
          "slack": {
            "description": "A Slack name or member id.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "x-visibility": "portal"
          }
        }
      }
    },
    "clarification_pages": {
      "description": "The slugs of every Clarification page now in the repo that belongs to this Portal project, as in dashboard/2. The Portal hides every page of the project not in the list, and clears that mark on every listed page. Optional: when it is missing, no page is touched. May be empty (then every page is hidden). Slugs unique (unique_page_slug). Server only.",
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
      },
      "x-visibility": "portal"
    }
  }
}
