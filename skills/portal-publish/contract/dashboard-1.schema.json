{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Relevant-S/ba-tools/skills/portal-publish/contract/dashboard-1.schema.json",
  "title": "dashboard/1",
  "description": "One Dashboard Publish: the envelope at the top level plus features, items, areas, release_rows and client_contacts. Readable twin: dashboard-1.md. x-visibility says who may see each leaf field: client, id, portal or admin.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "sent_at",
    "sent_by",
    "ba_tools_version",
    "features",
    "items",
    "areas",
    "release_rows",
    "client_contacts"
  ],
  "properties": {
    "contract": {
      "description": "Which contract this Publish follows. Written by the skill.",
      "type": "string",
      "const": "dashboard/1",
      "x-visibility": "admin"
    },
    "sent_at": {
      "description": "When the skill sent it, UTC, exactly YYYY-MM-DDTHH:MM:SS.sssZ.",
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "format": "date-time",
      "x-visibility": "admin"
    },
    "sent_by": {
      "description": "The git user name of the BA who sent it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "x-visibility": "admin"
    },
    "ba_tools_version": {
      "description": "The ba-tools version that sent it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "x-visibility": "admin"
    },
    "source_commit": {
      "description": "The Project repo commit the data came from.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-visibility": "admin"
    },
    "features": {
      "description": "The Features sent. A Feature with client: false is not sent.",
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "stage", "map_area"],
        "properties": {
          "id": {
            "description": "The Feature's id, else a slug of its title (R18). Unique in a Publish (check unique_feature_id).",
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "x-visibility": "id"
          },
          "title": {
            "description": "From area in dashboard.yaml.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "x-visibility": "client"
          },
          "short": {
            "description": "A short label.",
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "x-visibility": "client"
          },
          "summary": {
            "description": "Light HTML (light-html.json). From client_s, else s.",
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "x-visibility": "client"
          },
          "open": {
            "description": "Open questions, each plain text.",
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 500 },
            "x-visibility": "client"
          },
          "clar_url": {
            "description": "The Clarification page link; matched to a page's url. Server only.",
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "format": "uri",
            "x-visibility": "portal"
          },
          "stage": {
            "description": "From the map build.",
            "type": "string",
            "enum": ["concept", "spec", "ready", "dev", "qa", "done"],
            "x-visibility": "client"
          },
          "map_area": {
            "description": "The Map area (a Jira component), from the map build.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "x-visibility": "client"
          },
          "releases": {
            "description": "Release names, from the map build. Empty or absent = Not planned yet.",
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 100 },
            "x-visibility": "client"
          },
          "done_date": {
            "description": "When the Feature was done, YYYY-MM-DD. Used for Hide done > 2 weeks. Server only.",
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date",
            "x-visibility": "portal"
          }
        }
      }
    },
    "items": {
      "description": "Waiting and next-call agenda Items. Never todos, done: true or client: false.",
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "kind", "who", "since", "title"],
        "properties": {
          "key": {
            "description": "First 12 characters of sha1(\"<kind>|<title>\") (R18). Unique in a Publish (check unique_item_key).",
            "type": "string",
            "minLength": 12,
            "maxLength": 12,
            "pattern": "^[0-9a-f]{12}$",
            "x-visibility": "id"
          },
          "kind": {
            "description": "Which list the Item came from. Server only.",
            "type": "string",
            "enum": ["waiting", "agenda"],
            "x-visibility": "portal"
          },
          "feature": {
            "description": "The id of the Feature this Item sits under. Server only.",
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "x-visibility": "portal"
          },
          "who": {
            "description": "Who the Item waits on. Used only for Waiting on you (R13). Server only.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "x-visibility": "portal"
          },
          "since": {
            "description": "Since when, YYYY-MM-DD. Used only for order. Server only.",
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date",
            "x-visibility": "portal"
          },
          "title": {
            "description": "From t.",
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "x-visibility": "client"
          },
          "text": {
            "description": "Light HTML (light-html.json). From client_s, else s.",
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "x-visibility": "client"
          },
          "how_to_send": {
            "description": "How the Client sends it, from l.",
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "x-visibility": "client"
          }
        }
      }
    },
    "areas": {
      "description": "Map area names in order, from the map build.",
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 100 },
      "x-visibility": "client"
    },
    "release_rows": {
      "description": "Board rows in order, from the map build.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "released"],
        "properties": {
          "name": {
            "description": "The release name.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "x-visibility": "client"
          },
          "released": {
            "description": "Whether the release has shipped.",
            "type": "boolean",
            "x-visibility": "client"
          }
        }
      }
    },
    "client_contacts": {
      "description": "Client contacts, from tools.client_contacts (R14). Used only for Waiting on you. Each accepted Publish replaces the whole list. May be empty. Server only.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "description": "The contact's name.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "x-visibility": "portal"
          },
          "email": {
            "description": "The contact's email.",
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "format": "email",
            "x-visibility": "portal"
          },
          "slack": {
            "description": "A Slack name or member id.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "x-visibility": "portal"
          }
        }
      }
    }
  }
}
